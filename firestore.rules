rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnProfile(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'vit@mail.ru';
    }

    function isModerator() {
      return isAdmin()
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.moderator == true;
    }

    function isSeller() {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return profile.roles.seller == true || profile.isSeller == true;
    }

    // Профили: свой — читать и обновлять; админ — читать и обновлять любые;
    // модератор — менять только поле roles. Владелец не может менять себе роли.
    match /users/{uid} {
      allow read: if isOwnProfile(uid) || isAdmin() || isModerator();
      allow create: if isOwnProfile(uid);
      allow update: if isAdmin()
        || (isModerator()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roles']))
        || (isOwnProfile(uid)
            && !request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['roles', 'isSeller']));
      allow delete: if false;
    }

    // Заявки на роль продавца: id документа = uid заявителя.
    // Создаёт и удаляет владелец; читать и удалять (рассматривать) — модераторы.
    match /applications/{uid} {
      allow read: if isOwnProfile(uid) || isModerator();
      allow create: if isOwnProfile(uid)
        && request.resource.data.email == request.auth.token.email;
      allow update: if false;
      allow delete: if isOwnProfile(uid) || isModerator();
    }

    // Товары: читать может кто угодно, публиковать — только продавцы,
    // изменять и удалять — только владелец товара.
    match /products/{productId} {
      allow read: if true;
      allow create: if isSignedIn() && isSeller()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 1000
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() > 0
        && (!('images' in request.resource.data)
            || (request.resource.data.images is list
                && request.resource.data.images.size() > 0
                && request.resource.data.images.size() <= 10))
        && (!('variants' in request.resource.data)
            || request.resource.data.variants is map)
        && request.resource.data.category in ['phone', 'laptop']
        && request.resource.data.specs is map
        && request.resource.data.sellerUid == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.sellerUid == request.auth.uid;
    }
  }
}
