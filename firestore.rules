rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Профиль пользователя: читает и пишет только владелец
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Товары: читать может кто угодно, публиковать — только продавцы
    match /products/{productId} {
      allow read: if true;
      allow create: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isSeller == true
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 1000
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() > 0
        && request.resource.data.sellerUid == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.sellerUid == request.auth.uid;
    }
  }
}
